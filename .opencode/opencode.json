{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "timeout": 30000
    }
  },
  "instructions": ["AGENTS.md"],
  "compaction": {
    "auto": true,
    "tail_turns": 3
  }
}
